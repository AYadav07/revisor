# Runs deploy/backup.sh once. Triggered by revisor-backup.timer; logs go to the journal:
#   journalctl -u revisor-backup
[Unit]
Description=Revisor Postgres backup to object storage
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/opt/revisor
ExecStart=/opt/revisor/backup.sh
# Stay out of the way of the app on a 1 GB, shared-CPU machine.
Nice=10
IOSchedulingClass=idle
