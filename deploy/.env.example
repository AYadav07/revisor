# Copy to .env in the deploy directory on the VM (never commit the real one) and fill in.

# Postgres password, used by both the database and the backend. Long and random:
#   openssl rand -base64 32
DB_PASSWORD=

# The backend's public host name; Caddy gets its TLS certificate for it. DNS A record → the VM.
API_DOMAIN=api.revisor.aydev.in

# The frontend's exact origin(s), comma-separated. Never a wildcard.
APP_CORS_ALLOWED_ORIGINS=https://revisor.aydev.in

# Email (DEPLOYMENT.md "Email delivery"): SMTP2GO over plain SMTP. Use an SMTP user created in
# SMTP2GO just for Revisor, not the account login. Port 587 (or 2525) — GCP blocks outbound 25.
MAIL_HOST=mail.smtp2go.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# The sender; its domain must be verified in SMTP2GO with SPF/DKIM/DMARC records in DNS.
APP_MAIL_FROM=Revisor <noreply@aydev.in>
# Where links in emails point: the frontend, never the API.
APP_FRONTEND_URL=https://revisor.aydev.in

# Backups (deploy/README.md "Backups"). restic repository in S3-compatible object storage, e.g. a
# Backblaze B2 bucket via its S3 endpoint:
#   s3:https://s3.<region>.backblazeb2.com/<bucket>/revisor
RESTIC_REPOSITORY=
# Encrypts every backup. KEEP A COPY OUTSIDE THE VM (a password manager): without it the backups
# can't be restored. Generate with: openssl rand -base64 32
RESTIC_PASSWORD=
# The bucket's application key (B2: keyID / applicationKey), scoped to that one bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional dead-man's switch, e.g. a healthchecks.io check URL: pinged on success, /fail on failure,
# so a backup that silently stops running gets noticed.
BACKUP_PING_URL=

# Optional: pin an image tag (a commit SHA) instead of latest — how you roll back.
# BACKEND_TAG=latest
